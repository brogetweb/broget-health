# Render Node Web Service. Import real values from ignored .env.render.local.
APP_ENV=production
FIREBASE_PROJECT_ID=broget-health-ai
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
PUBLIC_APP_ORIGIN=https://broget-health-ai.web.app
ADDITIONAL_APP_ORIGINS=https://broget-health-ai.firebaseapp.com
MONGODB_URI=
MONGODB_DB_NAME=health_broget
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_API_KEY=
AI_MODEL=
USDA_API_KEY=
# Render supplies PORT automatically. Do not set Firebase emulator variables.
