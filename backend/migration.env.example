# Local runtime template; hosted runtime variables are in railway.env.example.
# Copy to backend/.env.migration.local (ignored by Git). Do not paste secrets in chat.
APP_ENV=development
PUBLIC_APP_ORIGIN=http://localhost:5173
# Use a separate empty development/staging database, with transaction support.
MONGODB_URI=
MONGODB_DB_NAME=health_broget_staging
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Use a dedicated staging Cloudinary environment if available.
# Firebase Authentication sends verification/reset emails; no separate mail service.
FIREBASE_PROJECT_ID=
# Private server-only credential file from the NEW Firebase project.
# Use the actual absolute local/Railway secret file path. Never commit its contents.
GOOGLE_APPLICATION_CREDENTIALS=

# Railway alternative to the local credential path (runtime only):
FIREBASE_SERVICE_ACCOUNT_JSON=
AI_API_KEY=
AI_MODEL=
USDA_API_KEY=
