# Runtime variables. Save values in Railway, never in Git.
APP_ENV=production
MONGODB_URI=
MONGODB_DB_NAME=health_broget
PUBLIC_APP_ORIGIN=https://YOUR-SERVICE.up.railway.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=
# Railway: private Admin SDK JSON as a multiline runtime-only variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local alternative: GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path.json
AI_API_KEY=
AI_MODEL=
USDA_API_KEY=
# PUBLIC Flutter web build variables (not Admin SDK credentials).
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
RECAPTCHA_SITE_KEY=
APP_DOWNLOAD_URL=
